---
import Header from "./Header.astro";
import Hero from "./Hero.astro";
import Services from "./Services.astro";
import SupportDesk from "./SupportDesk";
import CyberAudit from "./CyberAudit";
import Infrastructure from "./Infrastructure.astro";
import Method from "./Method.astro";
import ContactForm from "./ContactForm";
import Footer from "./Footer.astro";
import type { SiteCopy } from "../content/i18n";

interface Props {
  copy: SiteCopy;
}

const { copy } = Astro.props;
---

<Header copy={copy} />
<main>
  <Hero copy={copy.hero} />
  <Services copy={copy.services} />
  <SupportDesk copy={copy.support} client:load />
  <CyberAudit copy={copy.cyber} lang={copy.langTag} client:load />
  <Infrastructure copy={copy.infrastructure} />
  <Method copy={copy.method} />
  <ContactForm copy={copy.contact} client:load />
</main>
<Footer copy={copy} />
