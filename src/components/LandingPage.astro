---
import Header from "./Header.astro";
import Hero from "./Hero.astro";
import HomeOverview from "./HomeOverview.astro";
import AboutFounder from "./AboutFounder.astro";
import Services from "./Services.astro";
import Method from "./Method.astro";
import HomeTrust from "./HomeTrust.astro";
import ContactForm from "./ContactForm";
import Footer from "./Footer.astro";
import type { SiteCopy } from "../content/i18n";

interface Props {
  copy: SiteCopy;
}

const { copy } = Astro.props;
---

<Header copy={copy} />
<main>
  <Hero copy={copy.hero} />
  <HomeOverview langTag={copy.langTag} />
  {copy.langTag === "es-MX" && <AboutFounder />}
  <Services langTag={copy.langTag} />
  <Method copy={copy.method} />
  <HomeTrust langTag={copy.langTag} />
  <ContactForm copy={copy.contact} client:load />
</main>
<Footer copy={copy} />
