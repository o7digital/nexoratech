---
import type { SiteCopy } from "../content/i18n";

interface Props {
  copy: SiteCopy["hero"];
}

const { copy } = Astro.props;
---

<section class="hero" id="inicio">
  <div class="hero-copy">
    <p class="eyebrow">{copy.eyebrow}</p>
    <h1><span>{copy.title[0]}</span><span>{copy.title[1]}</span><span class="outline">{copy.title[2]}</span></h1>
    <p class="hero-text">{copy.text}</p>
    <div class="hero-actions">
      <a class="button button-dark" href="#helpdesk">{copy.primary} <span aria-hidden="true">↗</span></a>
      <a class="text-action" href="#cyber">{copy.secondary}</a>
    </div>
    <div class="hero-indicators">
      {copy.indicators.map(([value, label]) => <article><strong>{value}</strong><span>{label}</span></article>)}
    </div>
  </div>
  <div class="hero-dashboard" aria-label="Dashboard Control Center">
    <div class="dash-header"><span>{copy.dashboard.header}</span><b>{copy.dashboard.status}</b></div>
    <div class="availability"><span>{copy.dashboard.availability}</span><strong>99.94%</strong></div>
    <div class="lime-chart"><i></i><i></i><i></i><i></i><i></i><i></i></div>
    <div class="dash-grid">
      <article><span>{copy.dashboard.tickets}</span><strong>18</strong></article>
      <article><span>{copy.dashboard.devices}</span><strong>142</strong></article>
    </div>
    <div class="incident"><span></span><p>{copy.dashboard.incident}</p><b>08:42</b></div>
    <div class="remote-card"><b>{copy.dashboard.remoteTitle}</b><span>{copy.dashboard.remoteText}</span></div>
  </div>
</section>
