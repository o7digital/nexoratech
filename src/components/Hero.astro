---
import type { SiteCopy } from "../content/i18n";
import { site } from "../config/site";

interface Props {
  copy: SiteCopy["hero"];
}

const { copy } = Astro.props;
const slides = [
  "/slider/alex-kotliarskyi-QBpZGqEMsKg-unsplash.webp",
  "/slider/cdc-_XLJy3h77cw-unsplash.webp",
  "/slider/christina-wocintechchat-com-m-glRqyWJgUeY-unsplash.webp",
];
---

<section class="hero" id="inicio">
  <div class="hero-slider" aria-label={`Operación de soporte e infraestructura ${site.name}`}>
    {slides.map((src, index) => <img src={src} alt="" width="1600" height="1067" loading={index === 0 ? "eager" : "lazy"} fetchpriority={index === 0 ? "high" : "auto"} decoding="async" />)}
    <div class="hero-copy">
      <p class="eyebrow">{copy.eyebrow}</p>
      <h1>{copy.title.map((line, index) => <span class={index === copy.title.length - 1 ? "outline" : undefined}>{line}{index < copy.title.length - 1 ? " " : ""}</span>)}</h1>
      <p class="hero-text">{copy.text}</p>
      <div class="hero-actions">
        <a class="button button-primary" href="#contacto">{copy.primary} <span aria-hidden="true">↗</span></a>
        <a class="text-action" href="#servicios">{copy.secondary}</a>
      </div>
    </div>
  </div>
</section>
