---
import type { SiteCopy } from "../content/i18n";

interface Props {
  copy: SiteCopy["hero"];
}

const { copy } = Astro.props;
const slides = [
  "/slider/alex-kotliarskyi-QBpZGqEMsKg-unsplash.jpg",
  "/slider/cdc-_XLJy3h77cw-unsplash.jpg",
  "/slider/christina-wocintechchat-com-m-glRqyWJgUeY-unsplash.jpg",
  "/slider/kevin-ache-2JJ3wBHu4_0-unsplash.jpg",
  "/slider/paul-hanaoka-s0XabTAKvak-unsplash.jpg",
];
---

<section class="hero" id="inicio">
  <div class="hero-slider" aria-label="Nexora Tech operations">
    {slides.map((src, index) => <img src={src} alt="" loading={index === 0 ? "eager" : "lazy"} decoding="async" />)}
    <div class="hero-copy">
      <p class="eyebrow">{copy.eyebrow}</p>
      <h1><span>{copy.title[0]}</span><span>{copy.title[1]}</span><span class="outline">{copy.title[2]}</span></h1>
      <p class="hero-text">{copy.text}</p>
      <div class="hero-actions">
        <a class="button button-dark" href="#helpdesk">{copy.primary} <span aria-hidden="true">↗</span></a>
        <a class="text-action" href="#cyber">{copy.secondary}</a>
      </div>
      <div class="hero-indicators">
        {copy.indicators.map(([value, label]) => <article><strong>{value}</strong><span>{label}</span></article>)}
      </div>
    </div>
  </div>
</section>
