---
import Header from "./Header.astro";
import Footer from "./Footer.astro";
import ContactForm from "./ContactForm";
import type { SiteCopy } from "../content/i18n";
import type { ServicePageData } from "../content/services";
import { serviceBySlug } from "../content/services";
import { site } from "../config/site";

interface Props { page: ServicePageData; copy: SiteCopy; }
const { page, copy } = Astro.props;
const related = page.related.map((slug) => serviceBySlug[slug]).filter(Boolean);
---

<Header copy={copy} homeHref="/" />
<main class="service-page">
  <nav class="breadcrumbs" aria-label="Migas de pan"><a href="/">Inicio</a><span aria-hidden="true">/</span><span>{page.title}</span></nav>
  <header class="service-hero section-pad">
    <p class="eyebrow">{page.eyebrow}</p>
    <h1>{page.title}</h1>
    <p>{page.intro}</p>
    <a class="button button-primary" href="#contacto">Solicitar información <span aria-hidden="true">↗</span></a>
  </header>

  <section class="service-benefits section-pad" aria-label="Beneficios principales">
    {page.benefits.map(([title, text]) => <article><h2>{title}</h2><p>{text}</p></article>)}
  </section>

  <div class="service-content section-pad">
    {page.sections.map((section) => <section><h2>{section.title}</h2><p>{section.text}</p>{section.items && <ul>{section.items.map((item) => <li>{item}</li>)}</ul>}</section>)}
  </div>

  <section class="related-services section-pad" aria-labelledby="related-title">
    <p class="section-kicker">Servicios relacionados</p><h2 id="related-title">Una operación conectada necesita más de una disciplina.</h2>
    <div>{related.map((item) => <a href={`/${item.slug}/`}><strong>{item.eyebrow}</strong><span>{item.title}</span><b aria-hidden="true">↗</b></a>)}</div>
  </section>

  <section class="faq section-pad" aria-labelledby="faq-title">
    <p class="section-kicker">Preguntas frecuentes</p><h2 id="faq-title">Respuestas antes de comenzar.</h2>
    <div>{page.faq.map(([question, answer]) => <details><summary>{question}</summary><p>{answer}</p></details>)}</div>
  </section>

  <section class="service-cta section-pad"><div><p class="section-kicker">Siguiente paso</p><h2>{page.ctaTitle}</h2><p>{page.ctaText}</p></div><a class="button button-dark" href="#contacto">Hablar con {site.name} <span aria-hidden="true">↗</span></a></section>
  <ContactForm copy={copy.contact} client:load />
</main>
<Footer copy={copy} />
