---
const servers = ["Windows", "Linux", "Cloud", "On-premise", "Monitoring", "Respaldos", "Alertas", "Parches"];
---

<section class="infrastructure section-pad" id="infraestructura">
  <div>
    <p class="section-kicker">Infraestructura y equipos</p>
    <h2>DE LA NUBE AL TORNILLO.</h2>
    <p>Administracion de servidores, monitoreo, respaldos y soporte fisico para mantener la operacion completa bajo control.</p>
  </div>
  <div class="server-card">
    <div class="server-head"><span>ADMINISTRACION DE SERVIDORES</span><b>ONLINE</b></div>
    <div class="server-lines"><i></i><i></i><i></i><i></i><i></i></div>
    <div class="server-tags">{servers.map((item) => <span>{item}</span>)}</div>
  </div>
</section>
<section class="equipment section-pad" id="equipos">
  <p class="section-kicker">Equipos y refacciones</p>
  <h2>REPARAR, COMPRAR, VENDER E INSTALAR.</h2>
  <div class="equipment-grid">
    <article><h3>Reparacion</h3><p>Diagnostico, mantenimiento preventivo, correctivo, limpieza, optimizacion y recuperacion operativa.</p></article>
    <article><h3>Achat / Venta</h3><p>Equipos nuevos, seminuevos y reacondicionados para usuarios, direccion, servidores y puntos criticos.</p></article>
    <article><h3>Refacciones</h3><p>Memoria, discos, pantallas, baterias, fuentes, teclados y componentes instalados con pruebas.</p></article>
  </div>
</section>
