---
import type { SiteCopy } from "../content/i18n";

interface Props {
  copy: SiteCopy["infrastructure"];
}

const { copy } = Astro.props;
---

<section class="infrastructure section-pad" id="infraestructura">
  <div>
    <p class="section-kicker">{copy.kicker}</p>
    <h2>{copy.title}</h2>
    <p>{copy.text}</p>
  </div>
  <div class="server-card">
    <div class="server-head"><span>{copy.serverTitle}</span><b>{copy.online}</b></div>
    <div class="server-lines"><i></i><i></i><i></i><i></i><i></i></div>
    <div class="server-tags">{copy.servers.map((item) => <span>{item}</span>)}</div>
  </div>
</section>
<section class="equipment section-pad" id="equipos">
  <p class="section-kicker">{copy.equipmentKicker}</p>
  <h2>{copy.equipmentTitle}</h2>
  <div class="equipment-grid">
    {copy.equipment.map(([title, text]) => <article><h3>{title}</h3><p>{text}</p></article>)}
  </div>
</section>
