---
import type { SiteCopy } from "../content/i18n";

interface Props {
  copy: SiteCopy["method"];
}

const { copy } = Astro.props;
---

<section class="method section-pad" id="metodo">
  <p class="section-kicker">{copy.kicker}</p>
  <h2><span>{copy.title[0]}</span><span class="outline">{copy.title[1]}</span></h2>
  <div class="steps">
    {copy.steps.map(([n, title, text]) => <article><span>{n}</span><h3>{title}</h3><p>{text}</p></article>)}
  </div>
</section>
