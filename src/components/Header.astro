---
import type { SiteCopy } from "../content/i18n";
import { site } from "../config/site";

interface Props {
  copy: SiteCopy;
  homeHref?: string;
}

const { copy, homeHref = "" } = Astro.props;
const hrefFor = (href: string) => href.startsWith("/") ? href : `${homeHref}${href}`;
const isSpanishService = (href: string) => href.startsWith("/") && !href.startsWith("/en/") && !href.startsWith("/fr/") && !href.startsWith("/de/") && !href.startsWith("/pt/") && !href.startsWith("/it/");
---

<div class="status-bar" aria-label="Estado de cobertura">
  <span><i></i> {copy.status[0]}</span>
  {copy.status.slice(1).map((item) => <span>{item}</span>)}
</div>
<header class="site-header">
  <a class="brand brand-lockup" href={homeHref || "/"} aria-label={`${site.name}, inicio`}>
    <img src="/logo.jpeg" alt="" width="1254" height="1254" />
  </a>
  <nav class="desktop-nav" aria-label="Navegacion principal">
    {copy.nav.map(([label, href]) => <a href={hrefFor(href)} hreflang={isSpanishService(href) ? "es-MX" : undefined}>{label}</a>)}
  </nav>
  <div class="header-actions">
    <details class="language-switch">
      <summary aria-label="Change language">{copy.languageLabel}<span aria-hidden="true">⌄</span></summary>
      {copy.languageLinks.map(([label, href]) => <a href={href} hreflang={label.toLowerCase()}>{label}</a>)}
    </details>
    <a class="header-cta" href={hrefFor("#contacto")}>{copy.headerCta} <span aria-hidden="true">↗</span></a>
  </div>
  <details class="mobile-menu">
    <summary aria-label="Abrir menu"><span></span><span></span><span></span></summary>
    <nav aria-label="Navegacion movil">
      {copy.nav.map(([label, href]) => <a href={hrefFor(href)} hreflang={isSpanishService(href) ? "es-MX" : undefined}>{label}</a>)}
      {copy.languageLinks.map(([label, href]) => <a href={href}>{label}</a>)}
      <a class="mobile-menu-cta" href={hrefFor("#contacto")}>{copy.headerCta} <span aria-hidden="true">↗</span></a>
    </nav>
  </details>
</header>
