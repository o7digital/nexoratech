---
import type { SiteCopy } from "../content/i18n";

interface Props {
  copy: SiteCopy["services"];
}

const { copy } = Astro.props;
---

<section class="capability-rail" aria-label="Capacidades">
  {copy.capabilities.map((item) => <a href="#servicios"><span>{item}</span><b aria-hidden="true">+</b></a>)}
</section>
<section class="services-detail section-pad" id="servicios">
  <div class="section-head">
    <p class="section-kicker">{copy.kicker}</p>
    <h2>{copy.title}</h2>
  </div>
  <div class="service-grid">
    {copy.items.map(([id, title, text, details]) => (
      <article class="service-card">
        <span>{id}</span>
        <h3>{title}</h3>
        <p>{text}</p>
        <ul>
          {details.map((detail) => <li>{detail}</li>)}
        </ul>
      </article>
    ))}
  </div>
</section>
