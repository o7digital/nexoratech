---
import { getHomeCopy } from "../content/home";

interface Props {
  langTag: string;
}

const home = getHomeCopy(Astro.props.langTag);
---

<section class="services-detail section-pad" id="servicios">
  <div class="section-head">
    <p class="section-kicker">{home.servicesKicker}</p>
    <h2>{home.servicesTitle}</h2>
  </div>
  <div class="service-grid">
    {home.pillars.map(([title, text, benefits, href], index) => (
      <article class="service-card">
        <span>0{index + 1}</span>
        <h3>{title}</h3>
        <p>{text}</p>
        <ul>
          {benefits.map((benefit) => <li>{benefit}</li>)}
        </ul>
        <a class="service-link" href={href} hreflang={Astro.props.langTag === "es-MX" ? undefined : "es-MX"}>{index === 1 ? home.cyberCta : home.learnMore} <span aria-hidden="true">↗</span></a>
      </article>
    ))}
  </div>
</section>
