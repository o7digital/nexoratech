---
const formspreeEndpoint = "https://formspree.io/f/xyegynvq";
---

<div id="olivia-ai" data-formspree-endpoint={formspreeEndpoint}></div>

<style is:inline>
  #olivia-ai {
    position: fixed;
    right: 22px;
    bottom: 22px;
    z-index: 2147483646;
    font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Arial, sans-serif;
  }

  #olivia-ai * { box-sizing: border-box; }

  .olivia-panel {
    width: min(410px, calc(100vw - 28px));
    height: min(650px, calc(100vh - 112px));
    margin-bottom: 14px;
    display: none;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid rgba(32, 213, 232, .38);
    background: #080a12;
    color: #f4f1e9;
    box-shadow: 0 28px 90px rgba(0, 0, 0, .55);
  }

  .olivia-panel.is-open { display: flex; }

  .olivia-header {
    display: flex;
    justify-content: space-between;
    gap: 14px;
    padding: 18px;
    background: linear-gradient(135deg, rgba(32, 213, 232, .24), rgba(201, 255, 39, .12), rgba(255, 107, 74, .14)), #101f33;
    border-bottom: 1px solid rgba(244, 241, 233, .14);
  }

  .olivia-title {
    margin: 0;
    color: #20d5e8;
    font-size: 20px;
    font-weight: 950;
    line-height: 1.1;
    text-transform: uppercase;
    letter-spacing: .04em;
  }

  .olivia-status {
    margin: 5px 0 0;
    color: rgba(244, 241, 233, .72);
    font-size: 13px;
  }

  .olivia-close,
  .olivia-toggle,
  .olivia-teaser,
  .olivia-lead button,
  .olivia-composer button {
    border: 0;
    cursor: pointer;
    font: inherit;
  }

  .olivia-close {
    width: 40px;
    height: 40px;
    background: rgba(244, 241, 233, .1);
    color: #f4f1e9;
    font-weight: 950;
  }

  .olivia-messages {
    flex: 1;
    min-height: 190px;
    overflow-y: auto;
    padding: 16px;
    background:
      linear-gradient(rgba(244, 241, 233, .04) 1px, transparent 1px),
      #080f1a;
    background-size: 100% 42px;
  }

  .olivia-message {
    width: fit-content;
    max-width: 88%;
    margin: 0 0 10px;
    padding: 11px 13px;
    font-size: 14px;
    line-height: 1.45;
    white-space: pre-wrap;
  }

  .olivia-message.assistant {
    background: rgba(244, 241, 233, .1);
    color: #f4f1e9;
  }

  .olivia-message.user {
    margin-left: auto;
    background: #20d5e8;
    color: #080a12;
    font-weight: 800;
  }

  .olivia-lead {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 9px;
    padding: 14px;
    background: #101f33;
    border-top: 1px solid rgba(244, 241, 233, .12);
  }

  .olivia-lead p,
  .olivia-lead textarea,
  .olivia-lead button {
    grid-column: 1 / -1;
  }

  .olivia-lead p {
    margin: 0;
    color: rgba(244, 241, 233, .72);
    font-size: 13px;
    line-height: 1.4;
  }

  .olivia-lead input,
  .olivia-lead textarea,
  .olivia-composer input {
    width: 100%;
    min-width: 0;
    border: 1px solid rgba(32, 213, 232, .24);
    background: rgba(244, 241, 233, .08);
    color: #f4f1e9;
    font: inherit;
    font-size: 14px;
    outline: none;
  }

  .olivia-lead input,
  .olivia-lead textarea,
  .olivia-composer input {
    padding: 12px;
  }

  .olivia-lead textarea {
    min-height: 72px;
    resize: vertical;
  }

  .olivia-lead input::placeholder,
  .olivia-lead textarea::placeholder,
  .olivia-composer input::placeholder {
    color: rgba(244, 241, 233, .55);
  }

  .olivia-lead button,
  .olivia-composer button,
  .olivia-toggle {
    background: linear-gradient(135deg, #20d5e8, #c9ff27);
    color: #080a12;
    font-weight: 950;
  }

  .olivia-lead button {
    min-height: 44px;
  }

  .olivia-composer {
    display: grid;
    grid-template-columns: 1fr 54px;
    gap: 9px;
    padding: 14px;
    background: #080a12;
    border-top: 1px solid rgba(244, 241, 233, .12);
  }

  .olivia-composer button {
    font-size: 20px;
  }

  .olivia-composer button:disabled,
  .olivia-lead button:disabled {
    opacity: .58;
    cursor: not-allowed;
  }

  .olivia-closed {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 10px;
  }

  .olivia-teaser {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 11px 14px;
    border: 1px solid rgba(32, 213, 232, .34);
    background: #080a12;
    color: #f4f1e9;
    box-shadow: 0 18px 42px rgba(0, 0, 0, .35);
  }

  .olivia-avatar {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: #20d5e8;
    color: #080a12;
    font-weight: 950;
  }

  .olivia-toggle {
    min-width: 74px;
    height: 74px;
    padding: 0 15px;
    border-radius: 999px;
    box-shadow: 0 16px 44px rgba(0, 0, 0, .42);
  }

  @media (max-width: 560px) {
    #olivia-ai {
      right: 14px;
      bottom: 14px;
    }

    .olivia-lead {
      grid-template-columns: 1fr;
    }

    .olivia-toggle {
      min-width: 66px;
      height: 66px;
    }
  }
</style>

<script is:inline>
  (() => {
    const root = document.getElementById("olivia-ai");
    if (!root || root.dataset.ready === "true") return;
    root.dataset.ready = "true";

    const formspreeEndpoint = root.dataset.formspreeEndpoint;

    const copy = {
      es: {
        status: "Asistente IATERA",
        online: "En linea",
        teaser: "Necesitas soporte?",
        open: "Abrir Olivia AI",
        close: "Cerrar Olivia AI",
        welcome: "Hola, soy Olivia AI. Puedo ayudarte con soporte IT, ciberseguridad, servidores, equipos o componentes.",
        leadIntro: "Deja tus datos y el equipo de IATERA te contactara con el siguiente paso.",
        name: "Nombre",
        email: "Email",
        phone: "Telefono",
        need: "Necesidad",
        submitLead: "Enviar datos",
        leadThanks: "Gracias. Ya registramos tus datos para seguimiento.",
        placeholder: "Escribe tu pregunta...",
        send: "Enviar",
        sent: "Listo, quedo registrado.",
        error: "No pude enviar el mensaje. Intenta de nuevo.",
      },
      en: {
        status: "IATERA Assistant",
        online: "Online",
        teaser: "Need support?",
        open: "Open Olivia AI",
        close: "Close Olivia AI",
        welcome: "Hello, I am Olivia AI. I can help with IT support, cybersecurity, servers, equipment or components.",
        leadIntro: "Leave your details and the IATERA team will contact you with the next step.",
        name: "Name",
        email: "Email",
        phone: "Phone",
        need: "Need",
        submitLead: "Send details",
        leadThanks: "Thanks. Your details were registered for follow-up.",
        placeholder: "Write your question...",
        send: "Send",
        sent: "Done, it has been registered.",
        error: "I could not send the message. Please try again.",
      },
      fr: {
        status: "Assistante IATERA",
        online: "En ligne",
        teaser: "Besoin de support ?",
        open: "Ouvrir Olivia AI",
        close: "Fermer Olivia AI",
        welcome: "Bonjour, je suis Olivia AI. Je peux aider pour support IT, cybersecurite, serveurs, equipements ou composants.",
        leadIntro: "Laissez vos coordonnees et l'equipe IATERA vous contactera avec la prochaine etape.",
        name: "Nom",
        email: "Email",
        phone: "Telephone",
        need: "Besoin",
        submitLead: "Envoyer",
        leadThanks: "Merci. Vos coordonnees sont enregistrees pour le suivi.",
        placeholder: "Ecrivez votre question...",
        send: "Envoyer",
        sent: "C'est enregistre.",
        error: "Je n'ai pas pu envoyer le message. Veuillez reessayer.",
      },
      de: {
        status: "IATERA Assistentin",
        online: "Online",
        teaser: "Support benotigt?",
        open: "Olivia AI offnen",
        close: "Olivia AI schliessen",
        welcome: "Hallo, ich bin Olivia AI. Ich kann bei IT-Support, Cybersicherheit, Servern, Geraten oder Komponenten helfen.",
        leadIntro: "Hinterlassen Sie Ihre Daten und das Team von IATERA meldet sich mit dem nachsten Schritt.",
        name: "Name",
        email: "E-Mail",
        phone: "Telefon",
        need: "Bedarf",
        submitLead: "Daten senden",
        leadThanks: "Danke. Ihre Daten wurden fur die Nachverfolgung registriert.",
        placeholder: "Schreiben Sie Ihre Frage...",
        send: "Senden",
        sent: "Erledigt, es wurde registriert.",
        error: "Ich konnte die Nachricht nicht senden. Bitte versuchen Sie es erneut.",
      },
      pt: {
        status: "Assistente IATERA",
        online: "Online",
        teaser: "Precisa de suporte?",
        open: "Abrir Olivia AI",
        close: "Fechar Olivia AI",
        welcome: "Ola, sou Olivia AI. Posso ajudar com suporte de TI, ciberseguranca, servidores, equipamentos ou componentes.",
        leadIntro: "Deixe seus dados e a equipe IATERA entrara em contato com o proximo passo.",
        name: "Nome",
        email: "Email",
        phone: "Telefone",
        need: "Necessidade",
        submitLead: "Enviar dados",
        leadThanks: "Obrigado. Seus dados foram registrados para acompanhamento.",
        placeholder: "Escreva sua pergunta...",
        send: "Enviar",
        sent: "Pronto, ficou registrado.",
        error: "Nao consegui enviar a mensagem. Tente novamente.",
      },
      it: {
        status: "Assistente IATERA",
        online: "Online",
        teaser: "Serve supporto?",
        open: "Apri Olivia AI",
        close: "Chiudi Olivia AI",
        welcome: "Ciao, sono Olivia AI. Posso aiutare con supporto IT, cybersicurezza, server, apparecchiature o componenti.",
        leadIntro: "Lascia i tuoi dati e il team IATERA ti contattera con il prossimo passo.",
        name: "Nome",
        email: "Email",
        phone: "Telefono",
        need: "Necessita",
        submitLead: "Invia dati",
        leadThanks: "Grazie. I tuoi dati sono stati registrati per il follow-up.",
        placeholder: "Scrivi la tua domanda...",
        send: "Invia",
        sent: "Fatto, e stato registrato.",
        error: "Non sono riuscita a inviare il messaggio. Riprova.",
      },
    };

    const getLanguage = () => {
      const lang = (document.documentElement.lang || "").toLowerCase();
      const path = window.location.pathname;
      if (lang.startsWith("fr") || path.startsWith("/fr")) return "fr";
      if (lang.startsWith("en") || path.startsWith("/en")) return "en";
      if (lang.startsWith("de") || path.startsWith("/de")) return "de";
      if (lang.startsWith("pt") || path.startsWith("/pt")) return "pt";
      if (lang.startsWith("it") || path.startsWith("/it")) return "it";
      return "es";
    };

    const normalize = (value) => String(value || "")
      .toLowerCase()
      .normalize("NFD")
      .replace(/[\u0300-\u036f]/g, "");

    const lang = getLanguage();
    const t = copy[lang] || copy.es;
    let isOpen = false;
    let isLoading = false;
    let leadSent = false;
    let messages = [{ role: "assistant", content: t.welcome }];
    let lead = { name: "", email: "", phone: "", need: "" };

    const escapeHtml = (value) => String(value)
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;")
      .replace(/'/g, "&#039;");

    const transcript = () => messages.map((message) => `${message.role}: ${message.content}`).join("\n");

    const replyFor = (message) => {
      const value = normalize(message);
      const contact = {
        es: "Puedes pedir soporte aqui mismo dejando tus datos. Tambien puedo orientar la solicitud para Help Desk, Cyber Audit, servidores, reparacion, equipos o componentes.",
        en: "You can request support here by leaving your details. I can also route the request for Help Desk, Cyber Audit, servers, repair, equipment or components.",
        fr: "Vous pouvez demander du support ici en laissant vos coordonnees. Je peux aussi orienter la demande vers Help Desk, Cyber Audit, serveurs, reparation, equipements ou composants.",
        de: "Sie konnen hier Support anfragen, indem Sie Ihre Daten hinterlassen. Ich kann die Anfrage auch zu Help Desk, Cyber Audit, Servern, Reparatur, Geraten oder Komponenten leiten.",
        pt: "Voce pode solicitar suporte aqui deixando seus dados. Tambem posso direcionar a solicitacao para Help Desk, Cyber Audit, servidores, reparo, equipamentos ou componentes.",
        it: "Puoi richiedere supporto qui lasciando i tuoi dati. Posso anche indirizzare la richiesta verso Help Desk, Cyber Audit, server, riparazioni, apparecchiature o componenti.",
      };
      const cyber = {
        es: "Para Cyber Audit revisamos NIST CSF, identidad, MFA, correo, endpoints, red, respaldos, proveedores y respuesta a incidentes. Tambien hay cotizador en la seccion Cyber.",
        en: "For Cyber Audit we review NIST CSF, identity, MFA, email, endpoints, network, backups, providers and incident response. The Cyber section also includes a quote calculator.",
        fr: "Pour Cyber Audit, nous revoyons NIST CSF, identite, MFA, email, endpoints, reseau, sauvegardes, fournisseurs et reponse incidents. La section Cyber inclut aussi un cotisateur.",
        de: "Fur Cyber Audit prufen wir NIST CSF, Identitat, MFA, E-Mail, Endpoints, Netzwerk, Backups, Lieferanten und Incident Response. Die Cyber-Sektion enthalt auch einen Kalkulator.",
        pt: "Para Cyber Audit revisamos NIST CSF, identidade, MFA, e-mail, endpoints, rede, backups, fornecedores e resposta a incidentes. A secao Cyber tambem inclui um cotizador.",
        it: "Per Cyber Audit rivediamo NIST CSF, identita, MFA, email, endpoint, rete, backup, fornitori e risposta agli incidenti. La sezione Cyber include anche un calcolatore.",
      };
      const support = {
        es: "Para soporte IT podemos atender remoto o en sitio: correo, VPN, sistema operativo, aplicaciones, impresoras, accesos y estaciones de trabajo.",
        en: "For IT support we can help remotely or on site: email, VPN, operating system, applications, printers, access and workstations.",
        fr: "Pour le support IT, intervention a distance ou sur site : email, VPN, systeme, applications, imprimantes, acces et postes de travail.",
        de: "Beim IT-Support helfen wir remote oder vor Ort: E-Mail, VPN, Betriebssystem, Anwendungen, Drucker, Zugange und Arbeitsplatze.",
        pt: "Para suporte de TI atendemos remoto ou presencial: e-mail, VPN, sistema operacional, aplicacoes, impressoras, acessos e estacoes de trabalho.",
        it: "Per il supporto IT possiamo intervenire da remoto o in sede: email, VPN, sistema operativo, applicazioni, stampanti, accessi e workstation.",
      };
      const infra = {
        es: "En infraestructura cubrimos servidores Windows/Linux, cloud, on-premise, monitoreo, respaldos, hardening, parches y alertas.",
        en: "For infrastructure we cover Windows/Linux servers, cloud, on-premise, monitoring, backups, hardening, patches and alerts.",
        fr: "Pour l'infrastructure : serveurs Windows/Linux, cloud, on-premise, supervision, sauvegardes, hardening, correctifs et alertes.",
        de: "In der Infrastruktur decken wir Windows/Linux-Server, Cloud, On-Premise, Monitoring, Backups, Hardening, Patches und Alerts ab.",
        pt: "Em infraestrutura cobrimos servidores Windows/Linux, cloud, on-premise, monitoramento, backups, hardening, patches e alertas.",
        it: "Per l'infrastruttura copriamo server Windows/Linux, cloud, on-premise, monitoraggio, backup, hardening, patch e alert.",
      };
      const equipment = {
        es: "En equipos y componentes podemos ayudar con diagnostico, reparacion, compra/venta de equipos y componentes instalados con pruebas.",
        en: "For equipment and components, we can help with diagnosis, repair, buying/reselling equipment and tested component installation.",
        fr: "Pour equipements et composants : diagnostic, reparation, achat/vente et installation de composants testes.",
        de: "Bei Geraten und Komponenten helfen wir mit Diagnose, Reparatur, Kauf/Verkauf von Geraten und getesteter Komponenteninstallation.",
        pt: "Em equipamentos e componentes ajudamos com diagnostico, reparo, compra/venda de equipamentos e instalacao de componentes testados.",
        it: "Per apparecchiature e componenti aiutiamo con diagnosi, riparazione, acquisto/vendita e installazione di componenti testati.",
      };
      if (/\b(cyber|ciber|nist|audit|auditoria|auditor|seguridad|securite|security|sicherheit|seguranca|sicurezza|phishing|ransomware|mfa)\b/.test(value)) return cyber[lang];
      if (/\b(help|desk|support|soporte|suporte|supporto|remote|remoto|vpn|correo|email|e-mail|impresora|printer|drucker|impressora|stampante|ticket)\b/.test(value)) return support[lang];
      if (/\b(server|serveur|servidor|infra|linux|windows|cloud|backup|respaldo|sauvegarde|parche|patch|monitoring|monitoramento|monitoraggio)\b/.test(value)) return infra[lang];
      if (/\b(equipo|equipement|equipment|gerat|geraet|equipamento|apparecchiatura|repair|reparacion|reparation|reparo|riparazione|component|componente|componenti|komponente|laptop|desktop|bateria|battery|batterie)\b/.test(value)) return equipment[lang];
      return contact[lang];
    };

    const renderMessages = () => messages.map((message) => (
      `<div class="olivia-message ${message.role}">${escapeHtml(message.content)}</div>`
    )).join("") + (isLoading ? '<div class="olivia-message assistant">...</div>' : "");

    const render = () => {
      root.innerHTML = `
        <section class="olivia-panel ${isOpen ? "is-open" : ""}" aria-label="${escapeHtml(t.status)}">
          <header class="olivia-header">
            <div>
              <p class="olivia-title">Olivia AI</p>
              <p class="olivia-status">${escapeHtml(t.status)} · ${escapeHtml(t.online)}</p>
            </div>
            <button type="button" class="olivia-close" aria-label="${escapeHtml(t.close)}">x</button>
          </header>
          <div class="olivia-messages">${renderMessages()}</div>
          ${leadSent ? "" : `
            <form class="olivia-lead">
              <p>${escapeHtml(t.leadIntro)}</p>
              <input required name="name" placeholder="${escapeHtml(t.name)}" value="${escapeHtml(lead.name)}" />
              <input required type="email" name="email" placeholder="${escapeHtml(t.email)}" value="${escapeHtml(lead.email)}" />
              <input required type="tel" name="phone" placeholder="${escapeHtml(t.phone)}" value="${escapeHtml(lead.phone)}" />
              <textarea required name="need" rows="2" placeholder="${escapeHtml(t.need)}">${escapeHtml(lead.need)}</textarea>
              <button type="submit" ${isLoading ? "disabled" : ""}>${escapeHtml(t.submitLead)}</button>
            </form>
          `}
          <div class="olivia-composer">
            <input class="olivia-input" value="" ${isLoading ? "disabled" : ""} placeholder="${escapeHtml(t.placeholder)}" />
            <button type="button" class="olivia-send" ${isLoading ? "disabled" : ""} aria-label="${escapeHtml(t.send)}">&gt;</button>
          </div>
        </section>
        <div class="olivia-closed">
          ${isOpen ? "" : `
            <button type="button" class="olivia-teaser">
              <span class="olivia-avatar">O</span>
              <span>${escapeHtml(t.teaser)}</span>
            </button>
          `}
          <button type="button" class="olivia-toggle" aria-label="${escapeHtml(isOpen ? t.close : t.open)}">${isOpen ? "x" : "Olivia"}</button>
        </div>
      `;
      bindEvents();
      const messagesNode = root.querySelector(".olivia-messages");
      if (messagesNode) messagesNode.scrollTop = messagesNode.scrollHeight;
    };

    const saveLeadFields = () => {
      const form = root.querySelector(".olivia-lead");
      if (!form) return;
      lead = {
        name: form.name?.value || lead.name,
        email: form.email?.value || lead.email,
        phone: form.phone?.value || lead.phone,
        need: form.need?.value || lead.need,
      };
    };

    const submitLead = async (event) => {
      event.preventDefault();
      if (isLoading) return;
      saveLeadFields();
      if (!lead.name.trim() || !lead.email.trim() || !lead.phone.trim() || !lead.need.trim()) return;
      isLoading = true;
      render();
      try {
        const payload = new FormData();
        payload.set("name", lead.name.trim());
        payload.set("email", lead.email.trim());
        payload.set("phone", lead.phone.trim());
        payload.set("message", lead.need.trim());
        payload.set("source", "Olivia AI IATERA");
        payload.set("language", lang);
        payload.set("transcript", transcript());
        const response = await fetch(formspreeEndpoint, { method: "POST", body: payload, headers: { Accept: "application/json" } });
        if (!response.ok) throw new Error("Lead delivery failed");
        leadSent = true;
        messages.push({ role: "assistant", content: t.leadThanks });
      } catch (_error) {
        messages.push({ role: "assistant", content: t.error });
      } finally {
        isLoading = false;
        render();
      }
    };

    const sendMessage = () => {
      const input = root.querySelector(".olivia-input");
      const message = input?.value?.trim() || "";
      if (!message || isLoading) return;
      messages.push({ role: "user", content: message });
      messages.push({ role: "assistant", content: replyFor(message) });
      render();
    };

    const bindEvents = () => {
      root.querySelector(".olivia-toggle")?.addEventListener("click", () => {
        isOpen = !isOpen;
        render();
      });
      root.querySelector(".olivia-teaser")?.addEventListener("click", () => {
        isOpen = true;
        render();
      });
      root.querySelector(".olivia-close")?.addEventListener("click", () => {
        isOpen = false;
        render();
      });
      root.querySelector(".olivia-lead")?.addEventListener("submit", submitLead);
      root.querySelectorAll(".olivia-lead input, .olivia-lead textarea").forEach((input) => {
        input.addEventListener("input", saveLeadFields);
      });
      root.querySelector(".olivia-send")?.addEventListener("click", sendMessage);
      root.querySelector(".olivia-input")?.addEventListener("keydown", (event) => {
        if (event.key === "Enter") sendMessage();
      });
    };

    render();
  })();
</script>
