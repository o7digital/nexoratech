---
import "../styles/global.css";
import OliviaAI from "../components/OliviaAI.astro";
import type { SiteCopy } from "../content/i18n";

interface Props {
  copy: SiteCopy;
}

const { copy } = Astro.props;
const { title, description } = copy;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).toString() : Astro.url.toString();

const localBusiness = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  name: "Nexora Tech",
  url: canonical,
  areaServed: ["Ciudad de Mexico", "Estado de Mexico", "Mexico"],
  address: { "@type": "PostalAddress", addressCountry: "MX", addressRegion: "CDMX" },
  description: copy.businessDescription,
  makesOffer: copy.offers,
};

const services = {
  "@context": "https://schema.org",
  "@type": "Service",
  serviceType: copy.serviceType,
  provider: { "@type": "LocalBusiness", name: "Nexora Tech" },
  areaServed: { "@type": "Country", name: "Mexico" },
};
---

<!doctype html>
<html lang={copy.langTag}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={copy.locale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Nexora Tech" />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(localBusiness)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(services)} />
  </head>
  <body>
    <slot />
    <OliviaAI />
  </body>
</html>
