---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ServicePage from "../../components/ServicePage.astro";
import { siteCopy } from "../../content/i18n";
import { servicePages, type ServicePageData } from "../../content/services";
import { site } from "../../config/site";

export function getStaticPaths() {
  return servicePages.map((page) => ({ params: { slug: page.slug }, props: { page } }));
}

interface Props { page: ServicePageData; }
const { page } = Astro.props;
const url = `${site.url}/${page.slug}/`;
const serviceSchema = { "@context": "https://schema.org", "@type": "Service", "@id": `${url}#service`, name: page.title, description: page.description, url, provider: { "@id": `${site.url}/#organization` }, areaServed: { "@type": "Country", name: "México" } };
const breadcrumbSchema = { "@context": "https://schema.org", "@type": "BreadcrumbList", itemListElement: [{ "@type": "ListItem", position: 1, name: "Inicio", item: `${site.url}/` }, { "@type": "ListItem", position: 2, name: page.title, item: url }] };
const faqSchema = { "@context": "https://schema.org", "@type": "FAQPage", mainEntity: page.faq.map(([name, text]) => ({ "@type": "Question", name, acceptedAnswer: { "@type": "Answer", text } })) };
---

<BaseLayout copy={siteCopy.es} title={`${page.title} | ${site.name}`} description={page.description} homeAlternates={false} structuredData={[serviceSchema, breadcrumbSchema, faqSchema]}>
  <ServicePage page={page} copy={siteCopy.es} />
</BaseLayout>
